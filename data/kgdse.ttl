<https://w3id.org/kgdse/evidence/KGD-0001-access-status> a kd:DescriptorEvidence ;
    dcterms:source "https://www.microsoft.com/en-us/download/details.aspx?id=52312 (checked 2026-11-14; FB15K-237.2.zip returned HTTP 200)" ;
    kd:field "access_status" ;
    kd:note "Page shows Version 1.0; also mirrored in https://github.com/TimDettmers/ConvE (FB15k-237.tar.gz)." ;
    kd:quote "This dataset contains knowledge base relation triples and textual mentions of Freebase entity pairs" .

<https://w3id.org/kgdse/evidence/KGD-0001-creation-method> a kd:DescriptorEvidence ;
    dcterms:source "Toutanova & Chen 2015, https://aclanthology.org/W15-4007.pdf p. 64" ;
    kd:field "creation_method" ;
    kd:quote "We then automatically detected near-duplicate and inverse relations" .

<https://w3id.org/kgdse/evidence/KGD-0001-derived-from> a kd:DescriptorEvidence ;
    dcterms:source "Toutanova & Chen 2015, https://aclanthology.org/W15-4007.pdf p. 64" ;
    kd:field "derived_from" ;
    kd:note "Also: 'we filtered the set of relations to keep only one of a set of inverse or duplicate relations; this resulted in 237 relations'." ;
    kd:quote "constructed by first limiting the set of relations in FB15K to the most frequently used 401 relations" .

<https://w3id.org/kgdse/evidence/KGD-0001-human-verification> a kd:DescriptorEvidence ;
    dcterms:source "Toutanova & Chen 2015, https://aclanthology.org/W15-4007.pdf" ;
    kd:field "human_verification" ;
    kd:note "No human check of the triples is described." .

<https://w3id.org/kgdse/evidence/KGD-0001-input-source> a kd:DescriptorEvidence ;
    dcterms:source "Toutanova & Chen 2015, https://aclanthology.org/W15-4007.pdf p. 64" ;
    kd:field "input_source" ;
    kd:note "Triples come from FB15k, itself a Freebase subset." ;
    kd:quote "We then automatically detected near-duplicate and inverse relations by checking whether the set of entity pairs in the relations is either almost the same" .

<https://w3id.org/kgdse/evidence/KGD-0001-introducing-source> a kd:DescriptorEvidence ;
    dcterms:source "Crossref api.crossref.org/works/10.18653/v1/W15-4007; Toutanova & Chen 2015, https://aclanthology.org/W15-4007.pdf" ;
    kd:field "introducing_source" ;
    kd:note "The paper calls the dataset 'FB15KSelected'; the release page names it FB15K-237." ;
    kd:quote "Observed versus latent features for knowledge base and text inference" .

<https://w3id.org/kgdse/evidence/KGD-0001-licence> a kd:DescriptorEvidence ;
    dcterms:source "https://www.microsoft.com/en-us/download/details.aspx?id=52312" ;
    kd:field "licence" ;
    kd:note "Release page has only the generic Microsoft site terms; no dataset licence on the page (the zip may contain one; not downloaded)." .

<https://w3id.org/kgdse/evidence/KGD-0001-resource-kind> a kd:DescriptorEvidence ;
    dcterms:source "Toutanova & Chen 2015, https://aclanthology.org/W15-4007.pdf p. 62 (Fig. 5)" ;
    kd:field "resource_kind" ;
    kd:note "Link prediction / KB completion benchmark." ;
    kd:quote "FB15KSelected is a new dataset derived from FB15K and ClueWeb (described in text)." .

<https://w3id.org/kgdse/evidence/KGD-0001-size> a kd:DescriptorEvidence ;
    dcterms:source "Toutanova & Chen 2015, https://aclanthology.org/W15-4007.pdf p. 62 (Fig. 5)" ;
    kd:field "size" ;
    kd:note "Quote is the table row as extracted (layout split). Textual part: 'There are 6.6 million links induced from the textual relations'." ;
    kd:quote "FB15KSelected 237 14,541 ... 272,115 17,535 20,466" .

<https://w3id.org/kgdse/evidence/KGD-0001-target-source> a kd:DescriptorEvidence ;
    dcterms:source "Toutanova & Chen 2015, https://aclanthology.org/W15-4007.pdf p. 64" ;
    kd:field "target_source" ;
    kd:note "Held-out triples are the targets; no human labelling." ;
    kd:quote "we limited the training, validation, and development set triples to these relations" .

<https://w3id.org/kgdse/evidence/KGD-0002-access-status> a kd:DescriptorEvidence ;
    dcterms:source "https://github.com/TimDettmers/ConvE (checked 2026-11-14)" ;
    kd:field "access_status" ;
    kd:note "Repository file list." ;
    kd:quote "WN18RR.tar.gz" .

<https://w3id.org/kgdse/evidence/KGD-0002-creation-method> a kd:DescriptorEvidence ;
    dcterms:source "Dettmers et al. 2018, https://arxiv.org/pdf/1707.01476 (section 'Knowledge Graph Datasets')" ;
    kd:field "creation_method" ;
    kd:note "Creation by rule-based filtering (reviewer reading of the passage)." ;
    kd:quote "In order to ensure that we evaluate on datasets that do not have inverse relation test leakage, we apply our simple rule-based model" .

<https://w3id.org/kgdse/evidence/KGD-0002-derived-from> a kd:DescriptorEvidence ;
    dcterms:source "Dettmers et al. 2018, https://arxiv.org/pdf/1707.01476 (section 'Knowledge Graph Datasets')" ;
    kd:field "derived_from" ;
    kd:note "The inverse-relation removal is stated in the paper's leakage discussion; exact filtering rule not quoted here." ;
    kd:quote "we also find flaws with WN18. We thus create WN18RR to reclaim WN18 as a dataset" .

<https://w3id.org/kgdse/evidence/KGD-0002-human-verification> a kd:DescriptorEvidence ;
    dcterms:source "Dettmers et al. 2018, https://arxiv.org/pdf/1707.01476 (section 'Knowledge Graph Datasets')" ;
    kd:field "human_verification" .

<https://w3id.org/kgdse/evidence/KGD-0002-input-source> a kd:DescriptorEvidence ;
    dcterms:source "Dettmers et al. 2018, https://arxiv.org/pdf/1707.01476 (section 'Knowledge Graph Datasets')" ;
    kd:field "input_source" ;
    kd:quote "WN18 (Bordes et al. 2013a) is a subset of WordNet" .

<https://w3id.org/kgdse/evidence/KGD-0002-introducing-source> a kd:DescriptorEvidence ;
    dcterms:source "Crossref api.crossref.org/works/10.1609/aaai.v32i1.11573" ;
    kd:field "introducing_source" ;
