    kd:recordStatus "active" ;
    kd:researchCategory <https://w3id.org/kgdse/category/entity-resolution-and-kg-integration> ;
    kd:reviewerInterpretation "Wikidata aliases stand in for the CAC-ALMA correspondences that motivate the work; transfer to those records is not measured." ;
