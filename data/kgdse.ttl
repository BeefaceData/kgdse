<https://w3id.org/kgdse/record/B24-R051> a kd:DatasetUseRecord ;
    dcterms:identifier "B24-R051" ;
    prov:wasAttributedTo <https://w3id.org/kgdse/agent/reviewer> ;
    prov:wasDerivedFrom <https://w3id.org/kgdse/report/B24-AB32> ;
    kd:datasetVersionText "COVID-19 Chest X-ray Database (1,200 COVID-19, 1,341 normal, 1,345 viral pneumonia images) and RSNA Pneumonia (5,950 training, 662 test); medical KG named only as \"the renowned KG clove garden\" (PDF p. 4; no citation, version or size), TransR embeddings" ;
    kd:documentedUse "Testing: zero-shot ACC, AUC and F1 against ConVIRT, CLIP, SLIP and DeCLIP; CMKR ACC 0.501 (COVID-19) and 0.649 (RSNA); ablation shows adding the KG raises COVID-19 ACC from 0.279 to 0.501 at 6% more inference time." ;
    kd:domain <https://w3id.org/kgdse/domain/biomedical-and-health> ;
    kd:evidenceLocation "Sec. 5.1, p. 30; Sec. 5.4, Table 2, p. 31; Tables 3-4, p. 32" ;
    kd:facet <https://w3id.org/kgdse/facet/GEN>,
        <https://w3id.org/kgdse/facet/LM>,
        <https://w3id.org/kgdse/facet/MM> ;
    kd:fromReport <https://w3id.org/kgdse/report/B24-AB32> ;
    kd:metric "AUC",
        "Accuracy",
        "F1",
        "Runtime/efficiency" ;
    kd:pageConvention "printed page" ;
    kd:recordStatus "active" ;
    kd:researchCategory <https://w3id.org/kgdse/category/kg-supported-applications> ;
    kd:reviewerInterpretation "the medical KG is named only as \"KG clove garden\" without a citation, and its construction, version and size are not specified, so the KG component cannot be identified or reproduced; significance is claimed from t-tests with 2 degrees of freedom (p. 31). 'clove garden' is probably a literal translation of Dingxiang Yuan (DXY), a Chinese medical platform with a documented medical KG (SMedBERT, ACL 2021); the paper does not confirm this (reviewer inference(web check, 13 Nov 2026)." ;
    kd:role <https://w3id.org/kgdse/role/testing> ;
    kd:study <https://w3id.org/kgdse/study/B24-AB32> ;
    kd:subtask <https://w3id.org/kgdse/subtask/APP-03> ;
    kd:subtaskBasis "image" ;
    kd:taskDescription "KG-enhanced zero-shot medical image classification (CLIP with KG explicit knowledge and multimodal-LLM implicit knowledge)" ;
    kd:usesDataset <https://w3id.org/kgdse/dataset/KGD-0186>,
        <https://w3id.org/kgdse/dataset/KGD-0513>,
        <https://w3id.org/kgdse/dataset/KGD-1010> ;
    kd:versionStatus "version not stated" .

