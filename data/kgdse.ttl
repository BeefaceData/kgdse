    kd:recordStatus "active" ;
    kd:researchCategory <https://w3id.org/kgdse/category/kg-supported-applications> ;
    kd:reviewerInterpretation "only the best baseline is reported for mobility prediction and site selection (p. 17); use cases are demonstrations on the authors' own data without public test sets." ;
