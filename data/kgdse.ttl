<https://w3id.org/kgdse/record/B22-R036> a kd:DatasetUseRecord ;
    dcterms:identifier "B22-R036" ;
    prov:wasAttributedTo <https://w3id.org/kgdse/agent/reviewer> ;
    prov:wasDerivedFrom <https://w3id.org/kgdse/report/B22-E26-19> ;
    kd:datasetVersionText "WIT (Wikipedia-based Image Text; more than 37 million image-text associations) with Wikidata triples of linked QNodes (predicate statistics over about 400k QNodes); generated knowledge-grounded multi-turn conversations (up to 140k samples used for tuning; CLIP-filtered top-35k and top-70k subsets)" ;
    kd:documentedUse "Source data and training: WIT entity links resolved to Wikidata QNodes, triples filtered by predicate frequency (fewer than 10 mentions dropped) and identifier-pattern removal, verbalised and passed to an LLM to generate conversations, normalised to LLaVA-style chat and filtered by CLIP ViT-B/32 distance (threshold 0.7); SmolVLM and Granite-Vision-3.3 tuned with LoRA (35k/70k, with or without CLIP filtering) and full fine-tuning (70k/140k); training-loss dynamics and qualitative examples reported; pipeline used in Granite-Vision post-training." ;
    kd:domain <https://w3id.org/kgdse/domain/general-no-domain> ;
    kd:evidenceLocation "Sect. 3, pp. 364-369; Fig. 2 and Table 1, p. 365; Sect. 4.1-4.2, pp. 369-371; Figs. 3-5, pp. 369-371; Sect. 5, pp. 373-374" ;
    kd:facet <https://w3id.org/kgdse/facet/CONV>,
        <https://w3id.org/kgdse/facet/LM>,
        <https://w3id.org/kgdse/facet/MM> ;
    kd:fromReport <https://w3id.org/kgdse/report/B22-E26-19> ;
    kd:limitationDataset "Wikidata entries are noisy and sparse and false-positive triples still pass the filters (pp. 374-375)." ;
    kd:pageConvention "printed page" ;
    kd:recordStatus "active" ;
    kd:researchCategory <https://w3id.org/kgdse/category/kg-to-text-generation> ;
    kd:reviewerInterpretation "no release of the generated conversation dataset is stated; only the use of public resources is noted (p. 375)." ;
    kd:role <https://w3id.org/kgdse/role/source>,
        <https://w3id.org/kgdse/role/training> ;
    kd:scopeStudy "frequency-based filtering is a pragmatic heuristic that may amplify popularity bias and drop rare but informative relations (p. 366). reliance on entity-linked pages under-represents visually salient elements not mentioned in the article (p. 375)." ;
    kd:study <https://w3id.org/kgdse/study/B22-E26-19> ;
    kd:subtask <https://w3id.org/kgdse/subtask/K2T-02> ;
    kd:subtaskBasis "conversation" ;
    kd:taskDescription "KG-grounded multi-turn visual conversation generation for VLM instruction tuning" ;
