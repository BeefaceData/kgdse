<https://w3id.org/kgdse/record/B24-R048> a kd:DatasetUseRecord ;
    dcterms:identifier "B24-R048" ;
    prov:wasAttributedTo <https://w3id.org/kgdse/agent/reviewer> ;
    prov:wasDerivedFrom <https://w3id.org/kgdse/report/B24-AB16> ;
    kd:datasetVersionText "DrugBank release 5.1.13: drug-centred KG with all DDI edges removed (source KG) and three-class DDI relation labels derived from interaction descriptions" ;
    kd:documentedUse "Source KG, training and testing: group-aware 5-fold cross-validation with three seeds (15 runs; about 70/10/20 split, zero pair overlap); RA-DDI ACC 0.9234, Macro-F1 0.9102, AUC-ROC 0.9848, AUC-PR 0.9658, compared with DeepDDI, DrugDAGT, KGNN-DDI, SumGNN and others; ablation of seven components." ;
    kd:domain <https://w3id.org/kgdse/domain/biomedical-and-health> ;
    kd:evidenceLocation "Sec. Methods (KG construction), pp. 2-3; Sec. Experiments, pp. 6-7; Table 1, p. 8; Table 2, p. 10" ;
    kd:facet <https://w3id.org/kgdse/facet/LM>,
        <https://w3id.org/kgdse/facet/MM> ;
    kd:fromReport <https://w3id.org/kgdse/report/B24-AB16> ;
    kd:limitationDataset "authors state performance depends on the completeness, accuracy and coverage of the KG (p. 11)." ;
    kd:metric "AUC",
        "Accuracy",
        "F1" ;
    kd:pageConvention "printed page" ;
    kd:recordStatus "active" ;
    kd:researchCategory <https://w3id.org/kgdse/category/kg-supported-applications> ;
    kd:reviewerInterpretation "DDI edges were removed from the KG to prevent leakage (p. 3), a good practice not common in this batch." ;
    kd:role <https://w3id.org/kgdse/role/source>,
        <https://w3id.org/kgdse/role/testing>,
        <https://w3id.org/kgdse/role/training> ;
    kd:scopeStudy "random group-aware cross-validation does not assess temporal generalisation or cold-start drugs, and there is no prospective validation (p. 11)." ;
    kd:study <https://w3id.org/kgdse/study/B24-AB16> ;
    kd:subtask <https://w3id.org/kgdse/subtask/APP-06> ;
    kd:subtaskBasis "prediction" ;
    kd:taskDescription "Multi-class DDI prediction with a relation-aware multimodal drug KG (RGCN embeddings, SMILES, BioBERT text)" ;
    kd:usesDataset <https://w3id.org/kgdse/dataset/KGD-0029> ;
    kd:versionBasis "release" ;
    kd:versionStatus "version stated" .

