    prov:wasAttributedTo <https://w3id.org/kgdse/agent/reviewer> ;
    prov:wasDerivedFrom <https://w3id.org/kgdse/report/B24-AB15> ;
    kd:datasetVersionText "Southwest Hospital EMR KG; 5,000 held-out visits covering the 500 most frequent diseases; 1,000 inpatient visits for record ranking" ;
    kd:documentedUse "Testing: Naive Bayes diagnosis recommendation over KG probabilities reaches top-5 recall 74.20% and top-10 recall 88.76% against physicians' main diagnoses; KG-based ranking of medicines and exams in a visit reaches NDCG@5 0.87." ;
    kd:domain <https://w3id.org/kgdse/domain/biomedical-and-health> ;
    kd:evidenceLocation "Sec. 5.1, p. 8; Sec. 5.2, pp. 8-9" ;
    kd:fromReport <https://w3id.org/kgdse/report/B24-AB15> ;
    kd:metric "MAP/NDCG",
        "Recall" ;
    kd:pageConvention "printed page" ;
    kd:recordStatus "active" ;
    kd:researchCategory <https://w3id.org/kgdse/category/kg-supported-applications> ;
    kd:reviewerInterpretation "held-out visits come from the same hospital as the KG; the ground truth for record ranking is whether labelled entities occur in the visit, a weak proxy for clinical relevance." ;
    kd:role <https://w3id.org/kgdse/role/testing> ;
    kd:study <https://w3id.org/kgdse/study/B24-AB15> ;
    kd:subtask <https://w3id.org/kgdse/subtask/APP-01> ;
    kd:subtaskBasis "recommend" ;
    kd:taskDescription "KG-based clinical decision support: diagnosis recommendation and ranking of records within a visit" ;
    kd:usesDataset <https://w3id.org/kgdse/dataset/KGD-0150> ;
    kd:versionStatus "version not stated" .

