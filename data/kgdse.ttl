        <https://w3id.org/kgdse/role/training> ;
    kd:scopeStudy "baselines assume entities and relations are already linked (PDF p. 11)." ;
    kd:study <https://w3id.org/kgdse/study/B20-X04> ;
    kd:subtask <https://w3id.org/kgdse/subtask/QA-02> ;
    kd:subtaskBasis "semantic parsing" ;
    kd:taskDescription "Scholarly KGQA / semantic parsing to SPARQL (10 query types, compositional generalisation)" ;
