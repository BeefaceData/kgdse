<https://w3id.org/kgdse/record/B15-R014> a kd:DatasetUseRecord ;
    dcterms:identifier "B15-R014" ;
    prov:wasAttributedTo <https://w3id.org/kgdse/agent/reviewer> ;
    prov:wasDerivedFrom <https://w3id.org/kgdse/report/B15-E24-1> ;
    kd:datasetVersionText "CQ benchmark: design CQs of four ontologies from CORAL and Wisniewski et al. (2019): Video Game (66 CQs, 57 triples), African Wildlife (14, 26), Dem@care (107, 146), VICINITY Core (57, 226)" ;
    kd:documentedUse "Testing: candidate CQs generated by gpt-3.5-turbo-0613 and gpt-4-0613 from extracted ontology triples with three prompt templates and two temperature settings (0.0, 0.7) are matched to the design CQs with SBERT; precision, recall, F1, unmatched design CQs and cross-prompt overlap reported." ;
    kd:domain <https://w3id.org/kgdse/domain/media-and-social> ;
    kd:evidenceLocation "Sec. 3, p. 5; Table 1, p. 6; Sec. 4, p. 7; Tables 2-3, pp. 8-9; Table 5, p. 11" ;
    kd:facet <https://w3id.org/kgdse/facet/LM> ;
    kd:fromReport <https://w3id.org/kgdse/report/B15-E24-1> ;
    kd:metric "F1",
        "Precision",
        "Recall" ;
    kd:pageConvention "printed page" ;
    kd:recordStatus "active" ;
    kd:researchCategory <https://w3id.org/kgdse/category/ontology-schema-and-typing> ;
    kd:reviewerInterpretation "recall is defined with unmatched benchmark CQs labelled as true negatives (p. 7), and recall is at least 0.96 throughout, so precision carries the comparison. p. 8 calls CP=0.7 the deterministic value, which contradicts the definition on p. 7 (0.0 deterministic)." ;
    kd:role <https://w3id.org/kgdse/role/testing> ;
    kd:scopeStudy "only two OpenAI GPT models; a wider study is stated as in preparation (pp. 5, 11). four ontologies selected by three criteria (different developers, domains, many published CQs) (p. 5)." ;
    kd:study <https://w3id.org/kgdse/study/B15-E24-1> ;
    kd:subtask <https://w3id.org/kgdse/subtask/ONT-03> ;
    kd:subtaskBasis "Competency question" ;
    kd:taskDescription "Competency question (CQ) retrofitting from ontology triples with LLMs" ;
    kd:usesDataset <https://w3id.org/kgdse/dataset/KGD-0164>,
        <https://w3id.org/kgdse/dataset/KGD-0208>,
        <https://w3id.org/kgdse/dataset/KGD-0354>,
        <https://w3id.org/kgdse/dataset/KGD-0510>,
        <https://w3id.org/kgdse/dataset/KGD-1128>,
        <https://w3id.org/kgdse/dataset/KGD-1129> ;
    kd:versionBasis "2019" ;
    kd:versionStatus "version stated" .

<https://w3id.org/kgdse/record/B15-R015> a kd:DatasetUseRecord ;
    dcterms:identifier "B15-R015" ;
    prov:wasAttributedTo <https://w3id.org/kgdse/agent/reviewer> ;
    prov:wasDerivedFrom <https://w3id.org/kgdse/report/B15-E24-4> ;
    kd:datasetVersionText "Stanford (Protege) Wine ontology, used as gold standard" ;
    kd:documentedUse "Testing: wine ontologies generated by GPT-3.5 with zero-shot prompting, Stanford-guide prompts and the NeOn-GPT workflow are compared with the gold standard by structural metrics (OntoMetrics, Protege: axioms, classes, properties, individuals), class hierarchy and pre-/post-inference behaviour (HermiT)." ;
    kd:domain <https://w3id.org/kgdse/domain/food-and-agriculture> ;
    kd:evidenceLocation "Sec. 5-6, pp. 41-43; Table 1, p. 42; Figs. 10-11, p. 47" ;
    kd:facet <https://w3id.org/kgdse/facet/LM> ;
    kd:fromReport <https://w3id.org/kgdse/report/B15-E24-4> ;
    kd:pageConvention "printed page" ;
    kd:recordStatus "active" ;
    kd:researchCategory <https://w3id.org/kgdse/category/ontology-schema-and-typing> ;
    kd:reviewerInterpretation "comparison is by counts and hierarchy inspection, with no alignment-based precision or recall against the gold standard." ;
    kd:role <https://w3id.org/kgdse/role/testing> ;
    kd:scopeStudy "single domain case study (wine) (pp. 36, 41). LLM-generated class expressions limited to subsumption without conjunction or disjunction, and property restrictions mostly hasValue, so the generated ontology does not reach the gold standard's expressivity (p. 43)." ;
    kd:study <https://w3id.org/kgdse/study/B15-E24-4> ;
    kd:subtask <https://w3id.org/kgdse/subtask/ONT-04> ;
    kd:subtaskBasis "Ontology learning" ;
    kd:taskDescription "Ontology learning from natural-language domain descriptions with LLM prompt pipelines (NeOn methodology)" ;
    kd:usesDataset <https://w3id.org/kgdse/dataset/KGD-0352> ;
    kd:versionStatus "version not stated" .

