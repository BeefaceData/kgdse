    kd:pageConvention "printed page" ;
    kd:recordStatus "active" ;
    kd:researchCategory <https://w3id.org/kgdse/category/kg-construction-and-information-extraction> ;
    kd:reviewerInterpretation "evaluation uses only documents that already carry three to five author keywords, while the method is intended for documents without keywords." ;
    kd:role <https://w3id.org/kgdse/role/testing>,
        <https://w3id.org/kgdse/role/training> ;
    kd:scopeStudy "nouns, verbs and adjectives are all taken as candidates although keywords are mostly nominal, so verbal and adjectival keywords are inevitably selected; combined adjacent keywords are sometimes not nominal phrases (p. 24)." ;
    kd:study <https://w3id.org/kgdse/study/B21-Y01> ;
    kd:subtask <https://w3id.org/kgdse/subtask/CON-03> ;
    kd:subtaskBasis "Keyword extraction" ;
    kd:taskDescription "Keyword extraction for academic literature KG construction (keyword nodes for papers without author keywords)" ;
    kd:usesDataset <https://w3id.org/kgdse/dataset/KGD-0203> ;
    kd:versionBasis "V1" ;
    kd:versionStatus "version stated" .

