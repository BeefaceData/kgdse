    kd:datasetVersionText "Materials Project (over 120,000 computed materials); experimental band gaps and RefractiveIndex.info refractive indices (visible 589.3 nm and infrared) for benchmarking" ;
    kd:documentedUse "Analysis and validation: propnet applied to Materials Project entries adds on average 29 properties per material (9-fold increase; CdTe example); MIC correlation analysis finds 12 relations above 0.9 (e.g., Debye temperature vs Clarke thermal conductivity, 9 graph units apart); multiple derivation paths give Vickers hardness distributions (GaN vs experiment); five band-gap-to-refractive-index models benchmarked by RMSE against experimental data." ;
    kd:domain <https://w3id.org/kgdse/domain/industry-engineering-and-energy> ;
    kd:evidenceLocation "pp. 466-474; Figs. 2-5, pp. 468-473; Fig. 6, p. 475; Fig. 7 and Table 1, pp. 476-477; Experimental procedures, p. 479" ;
    kd:facet <https://w3id.org/kgdse/facet/EVAL> ;
    kd:fromReport <https://w3id.org/kgdse/report/B21-Y25> ;
    kd:limitationDataset "Materials Project values are mainly first-principles calculations (p. 466)." ;
    kd:metric "Correlation" ;
    kd:pageConvention "printed page" ;
    kd:recordStatus "active" ;
    kd:researchCategory <https://w3id.org/kgdse/category/kg-supported-applications> ;
    kd:role <https://w3id.org/kgdse/role/analysis>,
        <https://w3id.org/kgdse/role/testing> ;
    kd:scopeStudy "predictions differ considerably from measured refractive indices, especially below about 2.5, and the Ravindra model performs poorly (p. 474). experimental benchmarking data are in the Supplemental Information, not the PDF (p. 479)." ;
    kd:study <https://w3id.org/kgdse/study/B21-Y25> ;
    kd:subtask <https://w3id.org/kgdse/subtask/APP-07> ;
    kd:subtaskBasis "data" ;
    kd:taskDescription "KG-supported materials data augmentation, correlation discovery and model benchmarking" ;
    kd:usesDataset <https://w3id.org/kgdse/dataset/KGD-0288>,
        <https://w3id.org/kgdse/dataset/KGD-0815>,
        <https://w3id.org/kgdse/dataset/KGD-0998> ;
    kd:versionBasis "589.3" ;
    kd:versionStatus "version stated" .

