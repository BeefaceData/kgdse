    dcterms:identifier "1" ;
    dcterms:source "S7-S10. Resolved: 18 by named task, 60 by metric, 14 by same-study protocol, 24 from the paper; 3 held (rows 16-18)." ;
    prov:wasAssociatedWith <https://w3id.org/kgdse/agent/reviewer> ;
    kd:decisionGroup "Coding rules" ;
    kd:outcome "Accept" ;
    kd:proposal "If the task string names no task: task named in documented use; else metric (MRR/Hits@k/MR = link prediction; accuracy on true/false triples = triple classification); else same-study protocol; else read the paper; else hold." .

