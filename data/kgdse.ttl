        <https://w3id.org/kgdse/facet/TMP> ;
    kd:fromReport <https://w3id.org/kgdse/report/B15-E24-29> ;
    kd:limitationDataset "copyright prevents full disclosure of the corpus; only metadata to reproduce it is released (p. 213). text2AMR parsers may be inaccurate on historic and OCRed text and no standard benchmark exists; filtering kept 7,557 of 62,377 pairs (pp. 214-215)." ;
    kd:pageConvention "printed page" ;
    kd:recordStatus "active" ;
    kd:researchCategory <https://w3id.org/kgdse/category/kg-construction-and-information-extraction> ;
    kd:reviewerInterpretation "Table 2 prints counts with dots as thousands separators (e.g. 531.073), read here as 531,073 (p. 214)." ;
    kd:role <https://w3id.org/kgdse/role/introduced> ;
    kd:scopeStudy "co-reference resolution only for English (p. 214)." ;
    kd:study <https://w3id.org/kgdse/study/B15-E24-29> ;
    kd:subtask <https://w3id.org/kgdse/subtask/CON-03> ;
    kd:subtaskBasis "Text-to-KG" ;
    kd:taskDescription "Text-to-KG construction from multilingual diachronic historical texts via AMR (Text2AMR2FRED)" ;
    kd:usesDataset <https://w3id.org/kgdse/dataset/KGD-0870>,
        <https://w3id.org/kgdse/dataset/KGD-0871> ;
    kd:versionStatus "version not stated" .

