    kd:pageConvention "printed page" ;
    kd:recordStatus "active" ;
    kd:researchCategory <https://w3id.org/kgdse/category/kg-completion-and-link-prediction> ;
    kd:reviewerInterpretation "Table 3 reports the full model on FB15k-237 as MRR 0.464 and labels it 'FGC-KGC', while Table 2 and the text give 0.466 (pp. 17-19). Sec. 4.1 describes WN18RR as covering 'morphological relationships' such as synonymy and antonymy (p. 15)." ;
