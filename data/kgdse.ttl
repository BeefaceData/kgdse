    prov:wasAttributedTo <https://w3id.org/kgdse/agent/reviewer> ;
    prov:wasDerivedFrom <https://w3id.org/kgdse/report/B15-E24-23> ;
    kd:datasetVersionText "Helmholtz Knowledge Graph, first release (2.15 million metadata records from 32 Helmholtz data providers; 72 million triples; 16.35 million typed entities; 793k entities with a PID or URL; schema.org/JSON-LD)" ;
    kd:documentedUse "Dataset introduction: records harvested via OAI-PMH, sitemaps, feeds and DataCite/GitHub/GitLab APIs, uplifted with inferable types, de-duplicated with Prefect, loaded into Virtuoso and Solr, and exposed through SPARQL, web search and API." ;
    kd:domain <https://w3id.org/kgdse/domain/scholarly-and-education> ;
    kd:evidenceLocation "Sec. 2, pp. 184-186; Figs. 1-2; Data and Software Availability, p. 186" ;
    kd:fromReport <https://w3id.org/kgdse/report/B15-E24-23> ;
    kd:limitationDataset "metadata often lacks types and PIDs, producing duplicated blank-node instances that impair search (pp. 185-186). DOI PIDs are used heterogeneously for data and scholarly communications (p. 186)." ;
    kd:pageConvention "printed page" ;
    kd:recordStatus "active" ;
    kd:researchCategory <https://w3id.org/kgdse/category/kg-construction-and-information-extraction> ;
    kd:reviewerInterpretation "Fig. 1 caption reports 2.26 million main entities, the text 2.15 million records (pp. 184-185); these may count different things." ;
    kd:role <https://w3id.org/kgdse/role/introduced> ;
    kd:scopeStudy "entity resolution and type inference by logic and ML are future work (p. 186)." ;
    kd:study <https://w3id.org/kgdse/study/B15-E24-23> ;
    kd:subtask <https://w3id.org/kgdse/subtask/CON-06> ;
    kd:subtaskBasis "metadata" ;
    kd:taskDescription "Aggregation of research-output metadata into an institutional KG (harvesting, semantic uplifting, de-duplication)" ;
    kd:usesDataset <https://w3id.org/kgdse/dataset/KGD-0708> ;
    kd:versionBasis "release" ;
    kd:versionStatus "version stated" .

<https://w3id.org/kgdse/record/B15-R007> a kd:DatasetUseRecord ;
    dcterms:identifier "B15-R007" ;
