<https://w3id.org/kgdse/record/B21-R021> a kd:DatasetUseRecord ;
    dcterms:identifier "B21-R021" ;
    prov:wasAttributedTo <https://w3id.org/kgdse/agent/reviewer> ;
    prov:wasDerivedFrom <https://w3id.org/kgdse/report/B21-Y27> ;
    kd:datasetVersionText "ClimateIE (new; 25 climate-science publications from Semantic Scholar annotated in INCEpTION: 1,705 entity-publication links, 3,618 expert-validated relationships, 12 entity categories)" ;
    kd:documentedUse "Dataset introduction and testing: LLM pre-annotations validated by four domain experts (Kappa 0.77 for NER, 0.82 for RE); Llama-3.3-70B, Llama-3.1-8B, DeepSeek-V3, ClimateGPT, GPT-4o, NuNER and GLiNER compared with and without PreRAG/PostRAG on relaxed and strict P/R/F1 (best NER F1 0.501 relaxed; taxonomy-guided linking F1 0.367; RE F1 at most 0.078 relaxed / 0.053 strict for Llama-3.3); the reported reduction in hallucination is 23.3%." ;
    kd:domain <https://w3id.org/kgdse/domain/scholarly-and-education> ;
    kd:evidenceLocation "Sec. 7, p. 4300; Sec. 8-9, Tables 1-3, pp. 4301-4302" ;
    kd:facet <https://w3id.org/kgdse/facet/LM> ;
    kd:fromReport <https://w3id.org/kgdse/report/B21-Y27> ;
    kd:metric "F1" ;
    kd:pageConvention "printed page" ;
    kd:recordStatus "active" ;
    kd:researchCategory <https://w3id.org/kgdse/category/kg-construction-and-information-extraction> ;
    kd:reviewerInterpretation "25 publications is a small benchmark." ;
    kd:role <https://w3id.org/kgdse/role/introduced>,
        <https://w3id.org/kgdse/role/testing> ;
    kd:scopeStudy "relation extraction remains very weak, and poor entity matching propagates to RE (p. 4302). errors include extracting acronyms without full names and inconsistent handling of term variants (p. 4302). domain-specific validation is needed before claiming effectiveness in other domains (p. 4296)." ;
    kd:study <https://w3id.org/kgdse/study/B21-Y27> ;
    kd:subtask <https://w3id.org/kgdse/subtask/CON-02> ;
    kd:subtaskBasis "NER" ;
    kd:taskDescription "Taxonomy-guided LLM-RAG information extraction for domain KG construction (NER, entity linking to taxonomy, relation extraction)" ;
    kd:usesDataset <https://w3id.org/kgdse/dataset/KGD-0480> ;
    kd:versionStatus "version not stated" .

