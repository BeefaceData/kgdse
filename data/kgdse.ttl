<https://w3id.org/kgdse/record/B21-R016> a kd:DatasetUseRecord ;
    dcterms:identifier "B21-R016" ;
    prov:wasAttributedTo <https://w3id.org/kgdse/agent/reviewer> ;
    prov:wasDerivedFrom <https://w3id.org/kgdse/report/B21-Y21> ;
    kd:datasetVersionText "KnowLife KB (542,689 facts, 13 relations, average precision 93%) harvested from a corpus of 1,451,299 documents / 57,235,932 sentences: PubMed Medline 2011 (580,892) and PubMed Central (12,532); Drugs.com, Mayo Clinic, Medline Plus, RxList, Wikipedia Health; Healthboards.com, Patient.co.uk; UMLS as entity dictionary; 467 seed facts from uptodate.com" ;
    kd:documentedUse "Dataset introduction and validation: precision estimated by sampling facts per relation until the 95% Wilson interval width fell below 5%; 22,002 facts judged true or false by four annotators (Fleiss' Kappa 0.505); comparison of genre combinations (Table 4) and pipeline components (Table 5; without document-structure patterns precision falls to 78% and facts to about 80,000); error analysis of 760 incorrect facts." ;
    kd:domain <https://w3id.org/kgdse/domain/biomedical-and-health> ;
    kd:evidenceLocation "pp. 3-5; Tables 1-2, pp. 4-5; Evaluation, p. 7; Table 4, p. 7; Table 5 and ablation, p. 9; Error analysis, Table 7, pp. 9-10" ;
    kd:fromReport <https://w3id.org/kgdse/report/B21-Y21> ;
    kd:limitationDataset "precision varies by relation from 71% (createsRisk) to 97% (sideEffect) (p. 3); preprocessing errors come almost entirely from encyclopedic and social sources (p. 9)." ;
    kd:metric "Precision" ;
    kd:pageConvention "printed page" ;
    kd:recordStatus "active" ;
    kd:researchCategory <https://w3id.org/kgdse/category/kg-construction-and-information-extraction> ;
    kd:role <https://w3id.org/kgdse/role/introduced>,
        <https://w3id.org/kgdse/role/testing> ;
    kd:scopeStudy "recall is not evaluated because no gold standard of comprehensive facts exists (p. 7). no explicit named-entity disambiguation; the most specific UMLS type is chosen and type signatures prune later (p. 5). annotator agreement is moderate (p. 7)." ;
    kd:study <https://w3id.org/kgdse/study/B21-Y21> ;
    kd:subtask <https://w3id.org/kgdse/subtask/CON-07> ;
    kd:subtaskBasis "KG" ;
    kd:taskDescription "Biomedical KB/KG construction from multiple text genres (distantly supervised pattern extraction with consistency reasoning; 13 typed relations)" ;
    kd:usesDataset <https://w3id.org/kgdse/dataset/KGD-0009>,
        <https://w3id.org/kgdse/dataset/KGD-0092>,
        <https://w3id.org/kgdse/dataset/KGD-0706>,
        <https://w3id.org/kgdse/dataset/KGD-0773> ;
    kd:versionBasis "2011" ;
    kd:versionStatus "version stated" .

