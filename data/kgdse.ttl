    kd:quote "MIT license" .

<https://w3id.org/kgdse/evidence/KGD-0002-resource-kind> a kd:DescriptorEvidence ;
    dcterms:source "Dettmers et al. 2018, https://arxiv.org/pdf/1707.01476 (section 'Knowledge Graph Datasets')" ;
    kd:field "resource_kind" ;
    kd:note "Link prediction benchmark." ;
    kd:quote "we recommend against using FB15k and WN18 and instead recommend FB15k-237, WN18RR, and YAGO3-10." .

<https://w3id.org/kgdse/evidence/KGD-0002-size> a kd:DescriptorEvidence ;
    dcterms:source "Dettmers et al. 2018, https://arxiv.org/pdf/1707.01476 (section 'Knowledge Graph Datasets')" ;
