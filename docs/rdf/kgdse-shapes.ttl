@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix kd:      <https://w3id.org/kgdse/vocab#> .
@prefix ks:      <https://w3id.org/kgdse/shapes#> .

# SHACL shapes for the KG-DSE graph (14 Nov 2026). Checked by 05_scripts/validate.py.

ks:RecordShape a sh:NodeShape ;
  sh:targetClass kd:DatasetUseRecord ;
  sh:property [ sh:path dcterms:identifier ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^B[0-9]{2}-R[0-9]{3}$" ] ;
  sh:property [ sh:path kd:fromReport ; sh:minCount 1 ; sh:maxCount 1 ; sh:class kd:Report ] ;
  sh:property [ sh:path kd:study ; sh:minCount 1 ; sh:maxCount 1 ; sh:class kd:Study ] ;
  sh:property [ sh:path kd:researchCategory ; sh:minCount 1 ; sh:maxCount 1 ; sh:class kd:ResearchCategory ] ;
  sh:property [ sh:path kd:facet ; sh:class kd:Facet ] ;
  sh:property [ sh:path kd:evidenceLocation ; sh:minCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path kd:documentedUse ; sh:minCount 1 ] ;
  sh:property [ sh:path kd:recordStatus ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "active" "superseded" ) ] ;
  sh:property [ sh:path kd:pageConvention ; sh:maxCount 1 ; sh:in ( "printed page" "PDF page" ) ] ;
  sh:property [ sh:path prov:wasAttributedTo ; sh:minCount 1 ; sh:class prov:Agent ] ;
  # active records carry the full coding; superseded records (duplicate merge) point to their replacement
  sh:or ( ks:SupersededRecordShape ks:ActiveCodingShape ) .

ks:SupersededRecordShape a sh:NodeShape ;
  sh:property [ sh:path kd:recordStatus ; sh:hasValue "superseded" ] ;
  sh:property [ sh:path kd:supersededBy ; sh:minCount 1 ; sh:maxCount 1 ; sh:class kd:DatasetUseRecord ] .

ks:ActiveCodingShape a sh:NodeShape ;
  sh:property [ sh:path kd:recordStatus ; sh:hasValue "active" ] ;
  sh:property [ sh:path kd:subtask ; sh:minCount 1 ; sh:maxCount 1 ; sh:class kd:Subtask ] ;
  sh:property [ sh:path kd:domain ; sh:minCount 1 ; sh:class kd:Domain ] ;
  sh:property [ sh:path kd:role ; sh:minCount 1 ; sh:class kd:Role ] ;
  sh:property [ sh:path kd:usesDataset ; sh:minCount 1 ; sh:class dcat:Dataset ] ;
  sh:property [ sh:path kd:versionStatus ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "version stated" "version not stated" ) ] .

ks:PeripheralShape a sh:NodeShape ;
  sh:targetClass kd:PeripheralRecord ;
  sh:property [ sh:path kd:fromReport ; sh:minCount 1 ; sh:maxCount 1 ; sh:class kd:Report ] ;
  sh:property [ sh:path kd:evidenceLocation ; sh:minCount 1 ] .

ks:ReportShape a sh:NodeShape ;
  sh:targetClass kd:Report ;
  sh:property [ sh:path dcterms:bibliographicCitation ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path kd:study ; sh:minCount 1 ; sh:maxCount 1 ; sh:class kd:Study ] ;
  sh:property [ sh:path kd:decision ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "Include" "Exclude" ) ] ;
  sh:property [ sh:path kd:reason ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path kd:identificationRoute ; sh:minCount 1 ; sh:maxCount 1 ;
                sh:in ( "ResearchRabbit record" "proceedings volume chapter (not in RR)" "added outside RR" ) ] ;
  sh:property [ sh:path kd:batch ; sh:minCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:maxInclusive 24 ] .

ks:DatasetShape a sh:NodeShape ;
  sh:targetClass dcat:Dataset ;
  sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path dcterms:identifier ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^(KGD-[0-9]{4}|KGV-[0-9]{3})$" ] ;
  sh:property [ sh:path kd:resourceKind ; sh:maxCount 1 ;
                sh:pattern "^(Task benchmark|Knowledge graph|Ontology or vocabulary|Text corpus|Recommendation dataset|Other)" ] ;
  sh:property [ sh:path kd:creationMethod ; sh:maxCount 1 ; sh:pattern "^(Manual|Automatic|Hybrid|Not reported|not reported|unknown)" ] ;
  sh:property [ sh:path kd:humanVerification ; sh:maxCount 1 ;
                sh:pattern "^(Human verified|Not human verified|Not reported|not reported|not applicable|unknown)" ] ;
  sh:property [ sh:path kd:accessStatus ; sh:maxCount 1 ;
                sh:pattern "^(Public|Restricted / On request|Not publicly released|Release not located|Not reported|unknown)" ] ;
  sh:property [ sh:path kd:descriptorEvidence ; sh:class kd:DescriptorEvidence ] ;
  sh:property [ sh:path kd:sample ; sh:maxCount 1 ; sh:class kd:Sample ] .

ks:CanonicalDatasetShape a sh:NodeShape ;
  sh:targetSubjectsOf kd:recordCount ;
  sh:property [ sh:path kd:recordCount ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ] ;
  sh:property [ sh:path kd:studyCount ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ] .

ks:VariantShape a sh:NodeShape ;
  sh:targetSubjectsOf kd:variantOf ;
  sh:property [ sh:path kd:variantOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:class dcat:Dataset ] .

ks:EvidenceShape a sh:NodeShape ;
  sh:targetClass kd:DescriptorEvidence ;
  sh:property [ sh:path kd:field ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path dcterms:source ; sh:minCount 1 ] .

ks:SampleShape a sh:NodeShape ;
  sh:targetClass kd:Sample ;
  sh:property [ sh:path kd:reproduce ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^(yes|unclear|not reproduced)" ] ;
  sh:property [ sh:path kd:descriptorStatus ; sh:minCount 1 ; sh:maxCount 1 ] .

ks:SubtaskShape a sh:NodeShape ;
  sh:targetClass kd:Subtask ;
  sh:property [ sh:path skos:notation ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^[A-Z0-9]{2,4}-[0-9]{2}$" ] ;
  sh:property [ sh:path skos:prefLabel ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path skos:broader ; sh:minCount 1 ; sh:maxCount 1 ; sh:class kd:ResearchCategory ] ;
  sh:property [ sh:path skos:inScheme ; sh:minCount 1 ] .

ks:ConceptShape a sh:NodeShape ;
  sh:targetClass kd:ResearchCategory , kd:Facet , kd:Domain , kd:Role ;
  sh:property [ sh:path skos:prefLabel ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path skos:inScheme ; sh:minCount 1 ] .

ks:DecisionShape a sh:NodeShape ;
  sh:targetClass kd:Decision ;
  sh:property [ sh:path dcterms:date ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:date ] ;
  sh:property [ sh:path prov:wasAssociatedWith ; sh:minCount 1 ; sh:class prov:Agent ] .
